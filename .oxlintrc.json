{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "plugins": ["typescript", "unicorn", "react", "react-perf", "jsx-a11y", "promise", "import"],
  "settings": {
    "react": {
      "version": "19"
    },
    "jsx-a11y": {
      "polymorphicPropName": "as"
    }
  },
  "env": {
    "browser": true,
    "node": true,
    "builtin": true,
    "es2024": true
  },
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "prefer-const": ["error", { "ignoreReadBeforeAssign": true }],
    "no-console": ["warn", { "allow": ["warn", "error", "info"] }],
    "no-debugger": "error",
    "no-template-curly-in-string": "warn",
    "no-unused-vars": [
      "warn",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_id", "_type", "_key", "_ref", "_createdAt", "_updatedAt", "_rev"],
        "allowFunctionParams": true
      }
    ],

    "typescript/consistent-type-imports": [
      "warn",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "warn",
    "typescript/no-inferrable-types": "warn",

    "import/no-duplicates": "error",
    "import/first": "warn",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "**/*.scss", "**/*.less"]
      }
    ],

    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-target-blank": "error",
    "react/self-closing-comp": "warn",
    "react/no-unescaped-entities": "warn",
    "react/jsx-no-useless-fragment": "warn",

    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "warn",
    "react-perf/jsx-no-new-function-as-prop": "off",

    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-is-valid": "warn",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/no-autofocus": "warn",
    "jsx-a11y/heading-has-content": "warn",
    "jsx-a11y/img-redundant-alt": "warn",

    "unicorn/prefer-node-protocol": "warn",
    "unicorn/no-unreadable-array-destructuring": "warn",
    "unicorn/prefer-array-find": "warn",
    "unicorn/prefer-array-flat-map": "warn",
    "unicorn/prefer-includes": "warn",
    "unicorn/prefer-string-starts-ends-with": "warn",
    "unicorn/throw-new-error": "error",
    "unicorn/no-await-expression-member": "warn",

    "promise/no-multiple-resolved": "error",
    "promise/prefer-await-to-then": "off"
  },
  "overrides": [
    {
      "files": ["src/App.tsx", "src/pages/**", "src/components/**"],
      "rules": {
        "react-perf/jsx-no-jsx-as-prop": "off"
      }
    },
    {
      "files": ["*.config.{js,mjs,ts}", "*.d.ts"],
      "rules": {
        "no-console": "off",
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["scripts/**", "apps/**/scripts/**"],
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off",
        "unicorn/prefer-node-protocol": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/.next/**",
    "**/.sanity/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/public/**",
    "**/*.tsbuildinfo"
  ]
}
